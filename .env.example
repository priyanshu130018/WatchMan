# =============================================================================
# WatchMan — ROOT environment TEMPLATE (single consolidated file for LOCAL Docker)
# =============================================================================
# Copy this file to `.env` (same directory, next to compose.yml) and fill in
# real values, then start the whole stack with NO --env-file flag:
#
#     cp .env.example .env
#     # edit .env with your Supabase / Upstash / TMDB / OMDb / HF values
#     docker compose up --build      # frontend + backend + celery worker + beat
#     docker compose down
#
# Docker Compose auto-loads `.env` from this directory, so it serves BOTH roles:
#   * env_file: for the backend, celery_worker and celery_beat containers
#   * ${VITE_*} build-arg interpolation for the frontend image
#
# SECURITY
#   * The real `.env` holds SECRETS and is gitignored — never commit it.
#   * This `.env.example` must contain PLACEHOLDERS ONLY (no real secrets).
#   * Everything above the FRONTEND section is BACKEND-ONLY and is injected only
#     into the backend/celery containers — never into the browser bundle.
#   * Only the VITE_* variables at the very bottom are baked into the PUBLIC
#     frontend bundle. Never place database passwords, Redis credentials, the
#     Supabase service-role key, JWT signing secrets, or TMDB/OMDb server keys
#     in a VITE_* variable.
#   * WatchMan targets EXTERNAL managed services (Supabase Postgres + Upstash
#     Redis). There are intentionally no local postgres/redis containers.
# =============================================================================

# ============================ BACKEND (backend-only) =========================
# Injected into: backend, celery_worker, celery_beat.

# Application Settings
APP_NAME=WatchMan
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# Security & Authentication (Required)
# WatchMan uses FastAPI stateless HS256 JWT tokens for authentication.
# SECRET_KEY is used for cryptographic signing of access and refresh tokens.
# In production (APP_ENV=production), SECRET_KEY must be at least 32 characters long.
SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Authentication provider selection:
#   local    -> WatchMan FastAPI HS256 JWT + bcrypt authentication (Standard in dev and prod)
#   supabase -> Optional: validate external Supabase Auth tokens
AUTH_PROVIDER=local
# Supabase JWT secret is used ONLY if AUTH_PROVIDER=supabase.
# Leave blank when using standard local JWT authentication.
SUPABASE_JWT_SECRET=
# Expected audience claim on Supabase access tokens (Supabase default shown).
SUPABASE_JWT_AUD=authenticated

# Database Configuration (Required)
# PRODUCTION: point DATABASE_URL at Supabase PostgreSQL (via the connection
# pooler). SSL is enforced automatically for non-local hosts. Example:
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Strategy A (single connection string) takes precedence when set:
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/dbname
# Strategy B (split PostgreSQL parameters):
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# Supabase Authentication & Admin (Required). Backend-only keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# TMDB API (Required) - server-side key, backend-only
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
# Poster/backdrop CDN base used by the backend when shaping image URLs.
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# OMDb API (IMDb / Rotten Tomatoes / Metacritic ratings) - backend-only
OMDB_API_KEY=your_omdb_api_key_here
OMDB_BASE_URL=https://www.omdbapi.com/

# Redis & Celery (Required)
# PRODUCTION: use Upstash Redis (TLS). Share the rediss:// URL across cache +
# broker + result backend, e.g.:
#   REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379
#   CELERY_BROKER_URL=rediss://default:<password>@<name>.upstash.io:6379
#   CELERY_RESULT_BACKEND=rediss://default:<password>@<name>.upstash.io:6379
# Upstash requires TLS (rediss://). In production, localhost/Docker Redis is
# rejected at startup.
REDIS_URL=redis://your_redis_host:6379/0
CELERY_BROKER_URL=redis://your_redis_host:6379/0
CELERY_RESULT_BACKEND=redis://your_redis_host:6379/1

# CORS & Frontend URL (Required)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ML & pgvector (Required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384
ENABLE_PGVECTOR=true
ML_ADMIN_EMAILS=admin@example.com

# HuggingFace Inference API (remote embeddings, free tier)
# Create a token at https://huggingface.co/settings/tokens
HF_API_URL=https://router.huggingface.co/hf-inference/models
HF_API_TOKEN=your_hf_token_here

# Selective Content Embedding Strategy (defaults: 500 movies + 500 TV, on-demand interaction)
INITIAL_POPULAR_MOVIE_EMBED_LIMIT=500
INITIAL_POPULAR_TV_EMBED_LIMIT=500
ENABLE_INTERACTION_EMBEDDING=true
ENABLE_SEARCH_EMBEDDING=false
SEARCH_EMBED_THRESHOLD=3

# Hybrid recommendation blend weights (algorithm hyperparameters, NOT secrets).
# These have safe documented defaults in config.py; override only to re-tune the
# ranker. They should sum to ~1.0. See docs/RECOMMENDATION_ARCHITECTURE.md.
REC_WEIGHT_CONTENT=0.40
REC_WEIGHT_COLLABORATIVE=0.30
REC_WEIGHT_POPULARITY=0.15
REC_WEIGHT_FRESHNESS=0.10
REC_WEIGHT_PREFERENCE=0.05

# ALS collaborative-filtering hyperparameters (offline training only).
ALS_FACTORS=64
ALS_REGULARIZATION=0.05
ALS_ALPHA=40.0
ALS_ITERATIONS=15
ALS_SEED=42
ALS_MIN_USERS=3
ALS_MIN_ITEMS=3
ALS_MIN_INTERACTIONS=10

# ================= FRONTEND (PUBLIC VITE_* — baked into the browser bundle) ==================
# WARNING: every VITE_* value is publicly embedded into the client bundle at
# build time. Put ONLY public config here — never backend secrets, the Supabase
# service-role key, DB/Redis credentials, or server-side TMDB/OMDb keys.
# In compose.yml these are passed to the frontend image as build args via
# ${VITE_*} interpolation from this auto-loaded file.

# Backend API base URL used by the browser (Required)
VITE_API_BASE_URL=http://localhost:8000/api

# Frontend auth provider — keep in sync with backend AUTH_PROVIDER.
#   local    -> WatchMan FastAPI local JWT API (default and standard)
#   supabase -> Optional: browser authenticates via Supabase Auth
VITE_AUTH_PROVIDER=local

# Public Supabase client config.
# These are PUBLIC keys only (anon/publishable). NEVER the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# Public TMDB image CDN base for rendering posters in the browser.
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
