# Environment Variables
.env
.env.local
.env.*.local
# Any environment file with real secrets (production.env, staging.env, etc.)
*.env
# Belt-and-suspenders: ignore any file literally named `.env` at any depth
# (root ./.env, backend/.env, frontend/.env, ...). The bare `.env` rule above
# already matches nested paths; this just makes the intent explicit.
**/.env
# Only *.example TEMPLATES are tracked: the consolidated root .env.example plus
# the two per-app templates. The real, secret-bearing .env files stay ignored.
# LOCAL Docker now reads a single root .env (see .env.example / compose.yml).
!.env.example
!backend/.env.example
!frontend/.env.example

# TLS private keys / certificates must never be committed.
*.key
*.crt
*.pem

# root pytest cache
.pytest_cache/

