# =============================================================================
# WatchMan Frontend Environment Template
# =============================================================================
# Copy this file to frontend/.env and fill in required values.
# WARNING: All VITE_* variables are publicly embedded into the browser bundle at build time.
# NEVER put backend passwords, database credentials, or secret keys here!

# Backend API Base URL (Required)
VITE_API_BASE_URL=http://localhost:8000/api

# Authentication provider (Required for production).
#   supabase -> production: browser authenticates via Supabase Auth
#   local    -> development: legacy local JWT API (default if unset)
VITE_AUTH_PROVIDER=local

# Public Supabase Client Configuration.
# REQUIRED when VITE_AUTH_PROVIDER=supabase. These are PUBLIC keys only
# (anon/publishable). NEVER put the Supabase service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
