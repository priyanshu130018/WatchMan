# =============================================================================
# WatchMan Backend Environment Template
# =============================================================================
# Copy this file to backend/.env and fill in required values for your environment.
# All variables below are required (unless overriding Database via DATABASE_URL).
# Never commit secrets to version control.

# Application Settings
APP_NAME=WatchMan
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# Security & Authentication (Required)
# SECRET_KEY / ALGORITHM are used for the LOCAL development auth path only
# (AUTH_PROVIDER=local). They are still required so the app can boot in dev.
SECRET_KEY=your_secure_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Authentication provider selection (Required semantics):
#   local    -> development: this service mints/validates its own HS256 JWT + bcrypt
#   supabase -> PRODUCTION: validate Supabase Auth access tokens ONLY
# In production (APP_ENV=production) this MUST be 'supabase'; the app refuses to
# boot otherwise, and also refuses localhost DATABASE_URL/REDIS_URL.
AUTH_PROVIDER=local
# Supabase JWT secret used to validate access tokens when AUTH_PROVIDER=supabase.
# Found in Supabase: Project Settings -> API -> JWT Secret (symmetric HS256).
# Leave blank for local dev. REQUIRED in production.
SUPABASE_JWT_SECRET=
# Expected audience claim on Supabase access tokens (Supabase default shown).
SUPABASE_JWT_AUD=authenticated

# Database Configuration (Required)
# PRODUCTION: point DATABASE_URL at Supabase PostgreSQL (via the connection
# pooler). SSL is enforced automatically for non-local hosts. Example:
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Strategy A (Single connection string):
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/dbname
# Strategy B (Split PostgreSQL parameters) - local dev only:
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# Supabase Authentication & Admin (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# TMDB API (Required)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# OMDb API (IMDb / Rotten Tomatoes / Metacritic ratings) - required, no default
OMDB_API_KEY=your_omdb_api_key_here
OMDB_BASE_URL=https://www.omdbapi.com/

# Redis & Celery (Required)
# PRODUCTION: use Upstash Redis (TLS). Use the rediss:// URL from the Upstash
# console and share it across cache + broker + result backend, e.g.:
#   REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379
#   CELERY_BROKER_URL=rediss://default:<password>@<name>.upstash.io:6379
#   CELERY_RESULT_BACKEND=rediss://default:<password>@<name>.upstash.io:6379
# NOTE: Upstash requires TLS (rediss://). In production, localhost/Docker Redis
# is rejected at startup.
REDIS_URL=redis://your_redis_host:6379/0
CELERY_BROKER_URL=redis://your_redis_host:6379/0
CELERY_RESULT_BACKEND=redis://your_redis_host:6379/1

# CORS & Frontend URL (Required)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ML & pgvector (Required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384
ENABLE_PGVECTOR=true
ML_ADMIN_EMAILS=admin@example.com

# HuggingFace Inference API (remote embeddings, free tier)
# Create a token at https://huggingface.co/settings/tokens
HF_API_URL=https://api-inference.huggingface.co/pipeline/feature-extraction
HF_API_TOKEN=your_hf_token_here

# Hybrid recommendation blend weights (algorithm hyperparameters, NOT secrets).
# These have safe documented defaults in config.py; override only to re-tune the
# ranker. They should sum to ~1.0. See docs/RECOMMENDATION_ARCHITECTURE.md.
REC_WEIGHT_CONTENT=0.40
REC_WEIGHT_COLLABORATIVE=0.30
REC_WEIGHT_POPULARITY=0.15
REC_WEIGHT_FRESHNESS=0.10
REC_WEIGHT_PREFERENCE=0.05

# ALS collaborative-filtering hyperparameters (offline training only).
# Latent-factor matrix factorization over the User x Movie interaction matrix.
# ALS_MIN_* are the cold-catalog thresholds below which training is skipped.
ALS_FACTORS=64
ALS_REGULARIZATION=0.05
ALS_ALPHA=40.0
ALS_ITERATIONS=15
ALS_SEED=42
ALS_MIN_USERS=3
ALS_MIN_ITEMS=3
ALS_MIN_INTERACTIONS=10
