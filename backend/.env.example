# =============================================================================
# Rabbit Backend Configuration
# =============================================================================
APP_NAME=Rabbit
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your_super_secret_key
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30



# Supabase
SUPABASE_URL=your_supabase_url

SUPABASE_ANON_KEY=your_supabase_key

SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key


# PostgreSQL (Supabase)
POSTGRES_HOST=your_database_url
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_username
POSTGRES_PASSWORD=your_database_password

DATABASE_URL=postgresql://your_database_name:your_database_password@your_database_url/your_database_name

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

REDIS_URL=redis://localhost:6379/0


# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_secret_key
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback


# TMDB
TMDB_API_KEY=your_tmdb_api_key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original


# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json


# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60


# Cache
CACHE_TTL=3600


# Recommendation Engine
RECOMMENDATION_CACHE_TTL=1800
TRENDING_CACHE_TTL=3600


# ML
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384


# pgvector
ENABLE_PGVECTOR=true


# Frontend
FRONTEND_URL=http://localhost:5173